<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "future_expense", "data-turbo-track": "reload" %>
<% end %>

<div class="future-expense-container">
  <%# 支出合計 %>
  <section class="future-expense-summary">
    <div class="future-expense-summary-card">
      <div class="future-expense-summary-header">
        <div>
          <span class="future-expense-card-label">Future Expense</span>
          <h1>支出</h1>
        </div>
        <span class="future-expense-count"><%= @future_expenses.count %>件</span>
      </div>
      <div class="future-expense-total">
        <span>支出合計</span>
        <strong>¥<%= number_with_delimiter(@future_expenses.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 支出を追加", new_future_expense_path, class: "future-expense-add-button" %>
    </div>
  </section>

  <%# 支出一覧 %>
  <section class="future-expense-list-section">
    <div class="future-expense-card">
      <div class="future-expense-card-header">
        <div>
          <span class="future-expense-card-label">Future Expense List</span>
          <h2>支出一覧</h2>
        </div>
      </div>

      <% if @future_expenses.any? %>
        <div class="future-expense-list">
          <% @future_expenses.each do |future_expense| %>
            <div class="future-expense-item">
              <div>
                <span class="future-expense-item-name"><%= future_expense.name %></span>
              </div>
              <div class="future-expense-item-right">
                <strong>-¥<%= number_with_delimiter(future_expense.amount) %></strong>
                <span>→</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="future-expense-empty">
          <p>支出が登録されていません</p><%= link_to "支出を登録する", new_future_expense_path %>
        </div>
      <% end %>
      <div class="future-expense-actions">
        <%= link_to "編集する",
            edit_all_future_expenses_path,
            class: "future-expense-button future-expense-button-primary" %>
        <%= link_to "ホームへ",
            home_path,
            class: "future-expense-button future-expense-button-secondary" %>
      </div>
    </div>
  </section>
</div>



