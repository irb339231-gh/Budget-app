<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "future_expense_new", "data-turbo-track": "reload" %>
<% end %>

<div class="future-expense-new-container">
  <section class="future-expense-new-section">
    <div class="future-expense-new-card">
      <div class="future-expense-new-header">
        <span class="future-expense-new-card-label">New Future Expense</span>
        <h1>支出を追加</h1>
      </div>
      <%= form_with model: @future_expense,
          url: future_expenses_path,
          scope: :future_expense do |f| %>
        <%= render "devise/shared/error_messages", resource: @future_expense %>
        <div class="future-expense-new-form-group">
          <%= f.label :name, "支出名" %>
          <%= f.text_field :name,
              placeholder: "例：引っ越し、祝儀" %>
        </div>
        <div class="future-expense-new-form-group">
          <%= f.label :amount, "金額" %>
          <%= f.number_field :amount,
              placeholder: "例：100000" %>
        </div>
        <div class="future-expense-new-actions">
          <%= f.submit "追加する",
              class: "future-expense-new-button future-expense-new-button-primary" %>
          <%= link_to "戻る",
              future_expenses_path,
              class: "future-expense-new-button future-expense-new-button-secondary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>