<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "future_expense_edit", "data-turbo-track": "reload" %>
<% end %>

<div class="future-expense-edit-container">
  <section class="future-expense-edit-section">
    <div class="future-expense-edit-card">
      <div class="future-expense-edit-header">
        <span class="future-expense-edit-card-label">Edit Future Expense</span>
        <h1>支出を編集</h1>
      </div>
      <%= form_with model: @future_expense,
          url: future_expense_path(@future_expense),
          method: :patch,
          scope: :future_expense do |f| %>
        <%= render "devise/shared/error_messages", resource: @future_expense %>
        <div class="future-expense-edit-form-group">
          <%= f.label :name, "支出名" %>
          <%= f.text_field :name,
              placeholder: "例：引っ越し、祝儀" %>
        </div>
        <div class="future-expense-edit-form-group">
          <%= f.label :amount, "金額" %>
          <%= f.number_field :amount,
              placeholder: "例：1000000" %>
        </div>
        <div class="future-expense-edit-actions">
          <%= f.submit "更新する",
              class: "future-expense-edit-button future-expense-edit-button-primary" %>
          <%= link_to "戻る",
              edit_all_future_expenses_path,
              class: "future-expense-edit-button future-expense-edit-button-secondary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>