<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "future_expense_edit_all", "data-turbo-track": "reload" %>
<% end %>

<div class="future-expense-edit-all-container">
  <section class="future-expense-edit-all-summary">
    <div class="future-expense-edit-all-summary-card">
      <div class="future-expense-edit-all-summary-header">
        <div>
          <span class="future-expense-edit-all-card-label">Future Expense Edit</span>
          <h1>支出</h1>
        </div>
      </div>
      <div class="future-expense-edit-all-total">
        <span>支出合計</span>
        <strong>¥<%= number_with_delimiter(@future_expenses.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 支出を追加", new_future_expense_path,class: "future-expense-edit-all-add-button" %>
    </div>
  </section>
 
  <section class="future-expense-edit-all-list-section">
    <div class="future-expense-edit-all-card">
      <div class="future-expense-edit-all-card-header">
        <div>
          <span class="future-expense-edit-all-card-label">Future Expense List</span>
          <h2>支出編集</h2>
        </div>
      </div>

      <% if @future_expenses.any? %>
        <div class="future-expense-edit-all-list">
          <% @future_expenses.each do |future_expense| %>
            <div class="future-expense-edit-all-item">
              <div>
                <span class="future-expense-edit-all-item-name">
                  <%= future_expense.name %>
                </span>
              </div>
              <div class="future-expense-edit-all-item-right">
                <strong>¥<%= number_with_delimiter(future_expense.amount) %></strong>
                <%= link_to "編集",
                    edit_future_expense_path(future_expense),
                    class: "future-expense-edit-all-button future-expense-edit-all-button-edit" %>
                <%= button_to "削除",
                    future_expense_path(future_expense),
                    method: :delete,
                    class: "future-expense-edit-all-button future-expense-edit-all-button-delete",
                    data: { turbo_confirm: "削除してもよいですか？" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="future-expense-edit-all-empty">
          <p>支出が登録されていません</p>
          <%= link_to "支出を登録する", new_future_expense_path %>
        </div>
      <% end %>

      <div class="future-expense-edit-all-actions">
        <%= link_to "戻る",
            future_expenses_path,
            class: "future-expense-edit-all-button future-expense-edit-all-button-back" %>
      </div>
    </div>
  </section>
</div>