<div class="container mx-auto px-4 py-8 max-w-2xl">
  <%# ヘッダーカード %>
  <div class="rounded-3xl p-6 mb-6"
    style="background: linear-gradient(135deg, #f97316, #ea580c);">
        <p class="text-2xl font-bold">アカウント設定</p>
  </div>

  <%# 一覧 %>
  <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <div class="space-y-4">
          <%# ニックネーム%>
          <div class="flex items-center justify-between p-4 bg-base-100 rounded-2xl">
            <span class="font-bold">ニックネーム</span>
            <span><%= current_user.name %></span>
          </div>  
          
          <%# メールアドレス%>
          <div class="flex items-center justify-between p-4 bg-base-100 rounded-2xl">
            <span class="font-bold">メールアドレス</span>
            <span><%= current_user.email %></span>
          </div>

          <%# メール通知%>
          <div class="flex items-center justify-between p-4 bg-base-100 rounded-2xl">
            <span class="font-bold">メール通知</span>
              <%= form_with model: current_user, url: update_email_notification_path, method: :patch do |form| %>
                <%= form.check_box :email_notification, class: "toggle", onchange: "this.form.submit()" %>
              <% end %>
          </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-6">
        <%= link_to "編集する", edit_user_registration_path, class: "btn btn-primary rounded-2xl" %>
        <%= link_to "ホームへ", home_path, class: "btn btn-outline rounded-2xl" %>
      </div>

    </div>
  </div>
</div>