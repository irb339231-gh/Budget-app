<div class="container mx-auto px-4 py-8 max-w-lg">
  <ul class="steps w-full mb-8">
    <li class="step step-primary">
      <%= link_to "転職期間", wizard_path(:step1) %>
    </li>
    <li class="step">
      <%= link_to "収入", wizard_path(:step2) %>
    </li>
    <li class="step">
      <%= link_to "将来の支出", wizard_path(:step3) %>
    </li>
    <li class="step">
      <%= link_to "固定費", wizard_path(:step4) %>
    </li>
  </ul>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">Step1：転職活動期間の設定</h2>

      <%= form_with model: @user, url: wizard_path(step), method: :patch do |f| %>
        <div class="form-control mb-4">
          <%= f.label :job_search_start_month, "開始月", class: "label" %>
          <%= f.date_field :job_search_start_month, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mb-6">
          <%= f.label :job_search_end_month, "終了予定月", class: "label" %>
          <%= f.date_field :job_search_end_month, class: "input input-bordered w-full" %>
        </div>

        <div class="grid grid-cols-1gap-4">
          <%= f.submit "次へ", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>