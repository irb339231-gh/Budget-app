<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "wizard", "data-turbo-track": "reload" %>
<% end %>

<div class="wizard-container">
  <div class="wizard-progress">
    <span class="wizard-step-label">Step 1 / 4</span>
    <div class="wizard-steps">
      <div class="wizard-step wizard-step-active">
        <span>1</span>
        <p>転職期間</p>
      </div>
      <div class="wizard-step">
        <span>2</span>
        <p>収入</p>
      </div>
      <div class="wizard-step">
        <span>3</span>
        <p>将来の支出</p>
      </div>
      <div class="wizard-step">
        <span>4</span>
        <p>固定費</p>
      </div>
    </div>
  </div>

  <div class="wizard-card">
    <div class="wizard-card-header">
      <span class="wizard-card-label">Job Search Period</span>
      <h1>転職活動期間の設定</h1>
      <p>転職活動の開始月と終了予定月を設定してください</p>
    </div>
    <%= form_with model: @user, url: wizard_path(step), method: :patch do |f| %>
      <div class="wizard-form-group">
        <%= f.label :job_search_start_month, "開始月" %>
        <%= f.date_field :job_search_start_month, class: "wizard-input" %>
      </div>
      <div class="wizard-form-group">
        <%= f.label :job_search_end_month, "終了予定月" %>
        <%= f.date_field :job_search_end_month, class: "wizard-input" %>
      </div>
      <div class="wizard-actions">
        <%= link_to "スキップ",
            wizard_path(:step2),
            class: "wizard-button wizard-button-secondary" %>
        <%= f.submit "次へ",
            class: "wizard-button wizard-button-primary" %>
      </div>
    <% end %>
  </div>
</div>