<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "wizard", "data-turbo-track": "reload" %>
<% end %>

<div class="wizard-container">
  <div class="wizard-progress">
    <span class="wizard-step-label">Step 2 / 4</span>
    <div class="wizard-steps">
      <div class="wizard-step wizard-step-completed">
        <%= link_to wizard_path(:step1) do %>
          <span>1</span>
          <p>転職期間</p>
        <% end %>
      </div>
      <div class="wizard-step wizard-step-active">
        <span>2</span>
        <p>収入</p>
      </div>
      <div class="wizard-step">
        <span>3</span>
        <p>将来の支出</p>
      </div>
      <div class="wizard-step">
        <span>4</span>
        <p>固定費</p>
      </div>
    </div>
  </div>

  <div class="wizard-card">
    <div class="wizard-card-header">
      <span class="wizard-card-label">Income</span>
      <h1>収入の入力</h1>
      <p>貯蓄・退職金などを入力してください</p>
      <% if @incomes.any? %>
        <p class="wizard-total">
          合計：¥<%= number_with_delimiter(@incomes.sum(:amount)) %>
        </p>
      <% end %>
    </div>
    <% if @incomes.any? %>
      <div class="wizard-list">
        <% @incomes.each do |income| %>
          <div class="wizard-list-item">
            <span class="wizard-income-amount">
              +¥<%= number_with_delimiter(income.amount) %>
            </span>
            <%= button_to "削除",
                income_path(income),
                method: :delete,
                class: "wizard-delete-button",
                data: { turbo_confirm: "本当に削除しますか？" } %>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= form_with url: wizard_path(step), method: :patch do |f| %>
      <div class="wizard-form-group">
        <%= f.label :name, "収入名" %>
        <%= f.text_field :name,
            class: "wizard-input",
            placeholder: "例：貯蓄、退職金",
            name: "income[name]" %>
      </div>
      <div class="wizard-form-group">
        <%= f.label :amount, "金額" %>
        <%= f.number_field :amount,
            class: "wizard-input",
            placeholder: "例：1000000",
            name: "income[amount]" %>
      </div>
      <%= f.submit "追加する",
          class: "wizard-button wizard-button-secondary wizard-add-button" %>
    <% end %>
    <div class="wizard-actions">
      <%= link_to "戻る",
          wizard_path(:step1),
          class: "wizard-button wizard-button-secondary" %>
      <%= link_to "次へ",
          next_wizard_path,
          class: "wizard-button wizard-button-primary" %>
    </div>
  </div>
</div>