<div class="container mx-auto px-4 py-8 max-w-lg">
  <div class="rounded-3xl p-6 mb-6 text-white"
       style="background: linear-gradient(135deg, #f97316, #ea580c);">
    <p class="text-sm opacity-80 mb-1">Step 2 / 4</p>
    <p class="text-2xl font-bold">収入の入力</p>
    <p class="text-sm opacity-80 mt-1">貯蓄・退職金などを入力してください</p>
    <% if @incomes.any? %>
      <p class="text-sm opacity-80 mt-1">合計：¥<%= number_with_delimiter(@incomes.sum(:amount)) %></p>
    <% end %>
  </div>

  <ul class="steps w-full mb-8">
    <li class="step step-primary">
      <%= link_to "転職期間", wizard_path(:step1) %>
    </li>
    <li class="step step-primary">
      <%= link_to "収入", wizard_path(:step2) %>
    </li>
    <li class="step">
      <%= link_to "将来の支出", wizard_path(:step3) %>
    </li>
    <li class="step">
      <%= link_to "固定費", wizard_path(:step4) %>
    </li>
  </ul>

  <% if @incomes.any? %>
    <div class="card bg-base-200 shadow-xl mb-4">
      <div class="card-body">
        <div class="space-y-3">
           <% @incomes.each do |income| %>
             <div class="flex justify-between items-center p-3 bg-base-100 rounded-2xl">
                <span class="text-success font-bold">¥<%= number_with_delimiter(income.amount) %></span>
                <%= button_to "削除", income_path(income), method: :delete,
                    class: "btn btn-error btn-xs rounded-xl",
                    data: { turbo_confirm: "本当に削除しますか？" } %>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <%= form_with url: wizard_path(step), method: :patch do |f| %>
        <div class="form-control mb-4">
          <%= f.label :name, "収入名", class: "label font-bold" %>
          <%= f.text_field :name, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：貯蓄、退職金", name: "income[name]" %>
        </div>

        <div class="form-control mb-6">
          <%= f.label :amount, "金額", class: "label font-bold" %>
          <%= f.number_field :amount, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：1000000", name: "income[amount]" %>
        </div>

        <%= f.submit "追加する", class: "btn btn-outline w-full mb-4 rounded-2xl" %>
      <% end %>

        <div class="grid grid-cols-2 gap-4">
          <%= link_to "戻る", wizard_path(:step1), class: "btn btn-primary w-full rounded-2xl" %>
          <%= link_to "次へ", next_wizard_path, class: "btn btn-primary w-full rounded-2xl" %>
        </div>
    </div>
  </div>
</div>