<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "wizard", "data-turbo-track": "reload" %>
<% end %>

<div class="wizard-container">
  <div class="wizard-progress">
    <span class="wizard-step-label">Step 4 / 4</span>
    <div class="wizard-steps">
      <div class="wizard-step wizard-step-completed">
        <%= link_to wizard_path(:step1) do %>
          <span>1</span>
          <p>転職期間</p>
        <% end %>
      </div>
      <div class="wizard-step wizard-step-completed">
        <%= link_to wizard_path(:step2) do %>
          <span>2</span>
          <p>収入</p>
        <% end %>
      </div>
      <div class="wizard-step wizard-step-completed">
        <%= link_to wizard_path(:step3) do %>
          <span>3</span>
          <p>将来の支出</p>
        <% end %>
      </div>
      <div class="wizard-step wizard-step-active">
        <span>4</span>
        <p>固定費</p>
      </div>
    </div>
  </div>
  <div class="wizard-card">
    <div class="wizard-card-header">
      <span class="wizard-card-label">Fixed Cost</span>
      <h1>固定費の入力</h1>
      <p>ローン・家賃などを入力してください</p>
      <% if @fixed_costs.any? %>
        <p class="wizard-total wizard-total-expense">
          合計：¥<%= number_with_delimiter(@fixed_costs.sum(:amount)) %>
        </p>
      <% end %>
    </div>
    <% if @fixed_costs.any? %>
      <div class="wizard-list">
        <% @fixed_costs.each do |fixed_cost| %>
          <div class="wizard-list-item">
            <div>
              <span class="wizard-expense-name">
                <%= fixed_cost.name %>
              </span>
            </div>
            <div class="wizard-list-right">
              <span class="wizard-expense-amount">
                -¥<%= number_with_delimiter(fixed_cost.amount) %>
              </span>
              <%= button_to "削除",
                  fixed_cost_path(fixed_cost),
                  method: :delete,
                  class: "wizard-delete-button",
                  data: { turbo_confirm: "本当に削除しますか？" } %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= form_with url: wizard_path(step), method: :patch do |f| %>
      <div class="wizard-form-group">
        <%= f.label :name, "固定費名" %>
        <%= f.text_field :name,
            class: "wizard-input",
            placeholder: "例：ローン・家賃",
            name: "fixed_cost[name]" %>
      </div>
      <div class="wizard-form-group">
        <%= f.label :amount, "金額" %>
        <%= f.number_field :amount,
            class: "wizard-input",
            placeholder: "例：100000",
            name: "fixed_cost[amount]" %>
      </div>
      <%= f.submit "追加する",
          class: "wizard-button wizard-button-secondary wizard-add-button" %>
    <% end %>
    <div class="wizard-actions">
      <%= link_to "戻る",
          wizard_path(:step3),
          class: "wizard-button wizard-button-secondary" %>
      <%= link_to "完了",
          next_wizard_path,
          class: "wizard-button wizard-button-primary" %>
    </div>
  </div>
</div>