<div class="container mx-auto px-4 py-8 max-w-lg">
  <%# フォーム %>
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <%= form_with model: @income, url: income_path(@income), method: :patch, scope: :income do |f| %>
        <%= render "devise/shared/error_messages", resource: @income %>

        <div class="form-control mb-4">
          <%= f.label :name, "収入名", class: "label font-bold" %>
          <%= f.text_field :name, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：貯蓄、退職金" %>
        </div>

        <div class="form-control mb-6">
          <%= f.label :amount, "金額", class: "label font-bold" %>
          <%= f.number_field :amount, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：1000000" %>
        </div>

        <div class="form-control">
          <%= f.submit "更新する", class: "btn btn-primary w-full rounded-2xl" %>
        </div>
      <% end %>

      <%= link_to "戻る", edit_all_incomes_path, class: "btn btn-outline w-full mt-4 rounded-2xl" %>
    </div>
  </div>
</div>