<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "income", "data-turbo-track": "reload" %>
<% end %>

<div class="income-container">
  <%# 収入合計 %>
  <section class="income-summary">
    <div class="income-summary-card">
      <div class="income-summary-header">
        <div>
          <span class="income-card-label">Income</span>
          <h1>収入</h1>
        </div>
        <span class="income-count"><%= @incomes.count %>件</span>
      </div>
      <div class="income-total">
        <span>収入合計</span>
        <strong>¥<%= number_with_delimiter(@incomes.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 収入を追加", new_income_path, class: "income-add-button" %>
    </div>
  </section>

  <%# 収入一覧 %>
  <section class="income-list-section">
    <div class="income-card">
      <div class="income-card-header">
        <div>
          <span class="income-card-label">Income List</span>
          <h2>収入一覧</h2>
        </div>
      </div>

      <% if @incomes.any? %>
        <div class="income-list">
          <% @incomes.each do |income| %>
            <div class="income-item">
              <div>
                <span class="income-item-name"><%= income.name %></span>
              </div>
              <div class="income-item-right">
                <strong>+¥<%= number_with_delimiter(income.amount) %></strong>
                <span>→</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="income-empty">
          <p>収入が登録されていません</p><%= link_to "収入を登録する", new_income_path %>
        </div>
      <% end %>
      <div class="income-actions">
        <%= link_to "編集する",
            edit_all_incomes_path,
            class: "income-button income-button-primary" %>
        <%= link_to "ホームへ",
            home_path,
            class: "income-button income-button-secondary" %>
      </div>
    </div>
  </section>
</div>



