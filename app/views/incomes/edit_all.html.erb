<div class="container mx-auto px-4 py-8 max-w-2xl">
  <%# ヘッダーカード %>
  <div class="rounded-3xl p-6 mb-6 text-white"
       style="background: linear-gradient(135deg, #f97316, #ea580c);">
    <p class="text-sm opacity-80 mb-1">収入合計</p>
    <p class="text-4xl font-bold mb-4">
      ¥<%= number_with_delimiter(@incomes.sum(:amount)) %>
    </p>
    <div class="flex justify-between items-center"> 
      <p class="text-sm opacity-80">登録件数：<%= @incomes.count %>件</p>
      <%= link_to "＋ 追加する", new_income_path, class: "btn btn-sm bg-white text-primary border-none" %>
    </div>
  </div>

  <%# 一覧 %>
  <div class="card bg-base-200 shadow-xl mb-6">
    <div class="card-body">
      <h3 class="font-bold text-lg mb-4">収入編集</h3>

      <% if @incomes.any? %>
        <div class="space-y-3">
          <% @incomes.each do |income| %>
            <div class="flex justify-between items-center p-4 bg-base-100 rounded-2xl">
              <div class="flex items-center gap-3">
                <span class="font-bold"><%= income.name %></span>
              </div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-success">¥<%= number_with_delimiter(income.amount) %></span>
                <%= link_to "編集", edit_income_path(income), class: "btn btn-outline btn-xs rounded-xl" %>
                <%= button_to "削除", income_path(income),
                    method: :delete,
                    class: "btn btn-error btn-xs rounded-xl",
                    data: { turbo_confirm: "削除してもよいですか？" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-gray-500 py-8">
          <p>収入が登録されていません</p>
        </div>
      <% end %>

      <div class="mt-6">
        <%= link_to "戻る", incomes_path, class: "btn btn-outline w-full rounded-2xl" %>
      </div>
    </div>
  </div>

  <%# 各入力フォームへの導線 %>
  <div class="grid grid-cols-2 gap-4 mt-6">
    <a href="<%= future_expenses_path %>" class="btn btn-outline rounded-2xl">将来の支出</a>
    <a href="<%= fixed_costs_path %>" class="btn btn-outline rounded-2xl">固定費</a>
  </div>
</div>