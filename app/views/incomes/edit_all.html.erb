<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "income_edit_all", "data-turbo-track": "reload" %>
<% end %>

<div class="income-edit-all-container">
  <section class="income-edit-all-summary">
    <div class="income-edit-all-summary-card">
      <div class="income-edit-all-summary-header">
        <div>
          <span class="income-edit-all-card-label">Income Edit</span>
          <h1>収入</h1>
        </div>
      </div>
      <div class="income-edit-all-total">
        <span>収入合計</span>
        <strong>¥<%= number_with_delimiter(@incomes.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 収入を追加", new_income_path,class: "income-edit-all-add-button" %>
    </div>
  </section>
 
  <section class="income-edit-all-list-section">
    <div class="income-edit-all-card">
      <div class="income-edit-all-card-header">
        <div>
          <span class="income-edit-all-card-label">Income List</span>
          <h2>収入編集</h2>
        </div>
      </div>

      <% if @incomes.any? %>
        <div class="income-edit-all-list">
          <% @incomes.each do |income| %>
            <div class="income-edit-all-item">
              <div>
                <span class="income-edit-all-item-name">
                  <%= income.name %>
                </span>
              </div>
              <div class="income-edit-all-item-right">
                <strong>¥<%= number_with_delimiter(income.amount) %></strong>
                <%= link_to "編集",
                    edit_income_path(income),
                    class: "income-edit-all-button income-edit-all-button-edit" %>
                <%= button_to "削除",
                    income_path(income),
                    method: :delete,
                    class: "income-edit-all-button income-edit-all-button-delete",
                    data: { turbo_confirm: "削除してもよいですか？" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="income-edit-all-empty">
          <p>収入が登録されていません</p>
          <%= link_to "収入を登録する", new_income_path %>
        </div>
      <% end %>

      <div class="income-edit-all-actions">
        <%= link_to "戻る",
            incomes_path,
            class: "income-edit-all-button income-edit-all-button-back" %>
      </div>
    </div>
  </section>
</div>