<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "income_new", "data-turbo-track": "reload" %>
<% end %>

<div class="income-new-container">
  <section class="income-new-section">
    <div class="income-new-card">
      <div class="income-new-header">
        <span class="income-new-card-label">New Income</span>
        <h1>収入を追加</h1>
      </div>
      <%= form_with model: @income,
          url: incomes_path,
          scope: :income do |f| %>
        <%= render "devise/shared/error_messages", resource: @income %>
        <div class="income-new-form-group">
          <%= f.label :name, "収入名" %>
          <%= f.text_field :name,
              placeholder: "例：給与、退職金" %>
        </div>
        <div class="income-new-form-group">
          <%= f.label :amount, "金額" %>
          <%= f.number_field :amount,
              placeholder: "例：100000" %>
        </div>
        <div class="income-new-actions">
          <%= f.submit "追加する",
              class: "income-new-button income-new-button-primary" %>
          <%= link_to "戻る",
              incomes_path,
              class: "income-new-button income-new-button-secondary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>