<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "top2", "data-turbo-track": "reload" %>
<% end %>

<!-- ヘッダー及びフッターは後にapplication.htmlに移動-->
<header class="top-header">
    <div class="top-logo">
        <%= link_to "いくら。", root_path %>
    </div>
    <button class="menu-button" id="menu-button">
        <span></span>
        <span></span>
        <span></span>
    </button>
</header>

<!-- ヒーロ -->
<section class="hero-section fade-in" id="home">
    <div class="hero-content">
        <div class="hero-logo">
            <span class="hero-logo-main">いくら。</span>
        </div>
        <div class="hero-buttons">
            <%= link_to '新規登録', new_user_registration_path, class: "hero-button hero-button-primary" %>
            <%= link_to 'ログイン', new_user_session_path, class: "hero-button hero-button-secondary" %>
        </div>
    </div>
</section>

<!-- about -->
<section class="about-section fade-in" id="about">
    <div class="about-container">
        <h2 class="section-title">
            About
        </h2>
        <div class="about-introduction">
            <h3>
                「いくら。」とは？
            </h3>
            <p>
                「いくら。」は、転職活動中のお金の不安を解消します。
            </p>
            <p>
               退職してから次の仕事が決まるまで、収入がなくなることで、お金への不安は大きくなります。
            </p>
        </div>
        <div class="about-description">
            <p>
                「貯金は後どれくらい持つ？」
            </p>
            <p>
                「今月はいくらまで使っていい？」
            </p>
            <p>
                「このままで収入ゼロのまま転職活動を続けても大丈夫？」
            </p>
        </div>
        <div class="about-message">
            <p>
                「いくら。」では、貯金・収入・固定費・日々の支出などを入力することで、現在の資金状況を見える化します。<br>
                お金の不安を減らし、あなたが次の一歩を選択するための判断材料を提供します。
            </p>
        </div> 
    </div>
</section>

<!-- problem -->
<section class="problem-section fade-in" id="problem">
    <div class="problem-container">
        <h2 class="section-title">
            Problem
        </h2>
        <div class="problem-list">
            <article class="problem-item">
                <span>01</span>
                <h3>収入ゼロの不安、<br>
                誰に相談すればいいの？</h3>
                <p>
                    退職した途端に収入がゼロに。<br>
                    貯金を切り崩す毎日に「このままで大丈夫？」と不安になる。
                </p>
            </article>
            <article class="problem-item">
                <span>02</span>
                <h3>電卓・エクセルでの計算<br>
                もう疲れた。</h3>
                <p>
                    貯金・将来の支出・固定費...<br>
                    毎月計算するのは限界。<br>
                    もっと簡単に把握したい。
                </p>
            </article>
            <article class="problem-item">
                <span>03</span>
                <h3>お金の心配で、<br>
                転職活動に集中できない。</h3>
                <p>
                    「自分の挑戦したい企業に入る！」より、<br>
                    「来月の生活費、大丈夫かな？」が頭をよぎってしまう。
                </p>
            </article>
        </div>
    </div>
</section>

<!-- how to use -->
<section class="how-to-section fade-in" id="how-to-use">
    <div class="how-to-container">
        <h2 class="section-title">
            How to use
        </h2>
        <div class="how-to-list">
            <article class="how-to-item">
                <span>01</span>
                <h3>新規登録する</h3>
                <p>
                    アカウントを作成して、ログインします。
                </p>
            </article>
            <article class="how-to-item">
                <span>02</span>
                <h3>期間・お金の情報を入力</h3>
                <p>
                    転職期間・貯金・将来の支出・<br>
                    固定費などを入力するだけ。<br>
                    ガイドに沿って簡単に入力できます。
                </p>
            </article>
            <article class="how-to-item">
                <span>03</span>
                <h3>今使える金額を確認</h3>
                <p>
                    入力した情報から自動で計算。<br>
                    日・週・月・全体の期間から「今使える金額」を確認できます。
                </p>
            </article>
        </div>
    </div>
</section>





