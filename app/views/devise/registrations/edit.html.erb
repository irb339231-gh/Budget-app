<div class="container mx-auto px-4 py-8 max-w-lg">
  <%# ヘッダーカード %>
  <div class="rounded-3xl p-6 mb-6 text-white"
    style="background: linear-gradient(135deg, #f97316, #ea580c);">
    <p class="text-2xl font-bold">アカウント編集</p>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">アカウント編集</h2>

      <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-control mb-4">
          <%= f.label :name, "ニックネーム", class: "label font-bold" %>
          <%= f.text_field :name, autofocus: true, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：山田太郎" %>
        </div>

        <div class="form-control mb-4">
          <%= f.label :email, "メールアドレス", class: "label font-bold" %>
          <%= f.email_field :email, class: "input input-bordered w-full rounded-2xl",
              placeholder: "例：sample@example.com" %>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <%= f.submit "更新する", class: "btn btn-primary rounded-2xl" %>
          <%= link_to "戻る", user_profile_path, class: "btn btn-outline rounded-2xl" %>
        </div>
      <% end %>
    </div>
  </div>
</div>