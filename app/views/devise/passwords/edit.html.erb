<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "devise_passwords_edit", "data-turbo-track": "reload" %>
<% end %>

<div class="devise-password-edit-container">
  <div class="devise-password-edit-card">
    <div class="devise-password-edit-header">
      <span class="devise-password-edit-card-label">New Password</span>
      <h1>パスワード再設定</h1>
    </div>
    <%= form_with model: resource,
        as: resource_name,
        url: password_path(resource_name),
        method: :put do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div class="devise-password-edit-form-group">
        <%= f.label :password, "新しいパスワード" %>
        <% if @minimum_password_length %>
          <p class="devise-password-edit-password-hint">
            <%= @minimum_password_length %>文字以上
          </p>
        <% end %>
        <%= f.password_field :password,
            autofocus: true,
            autocomplete: "new-password",
            placeholder: "新しいパスワードを入力" %>
      </div>
      <div class="devise-password-edit-form-group">
        <%= f.label :password_confirmation, "新しいパスワード確認" %>

        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "もう一度入力" %>
      </div>
      <div class="devise-password-edit-actions">
        <%= f.submit "パスワードを変更する",
            class: "devise-password-edit-button devise-password-edit-button-primary" %>
      </div>
    <% end %>

    <div class="devise-password-edit-links">
      <%= link_to "ログインに戻る",
          new_session_path(resource_name),
          class: "devise-password-edit-link" %>
    </div>
  </div>
</div>