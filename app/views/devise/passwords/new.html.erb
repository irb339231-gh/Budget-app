<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "devise_passwords_new", "data-turbo-track": "reload" %>
<% end %>

<div class="devise-password-container">
  <div class="devise-password-card">
    <div class="devise-password-header">
      <span class="devise-password-card-label">Password Reset</span>
      <h1>パスワードをお忘れの方</h1>
    </div>
    <%= form_with model: resource,
        as: resource_name,
        url: password_path(resource_name),
        method: :post do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="devise-password-form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "example@email.com" %>
      </div>
      <div class="devise-password-actions">
        <%= f.submit "パスワードリセットメールを送信する",
            class: "devise-password-button devise-password-button-primary" %>
      </div>
    <% end %>

    <div class="devise-password-links">
      <%= link_to "ログイン",
          new_session_path(resource_name),
          class: "devise-password-link-primary" %>
      <%= link_to "新規登録",
          new_registration_path(resource_name),
          class: "devise-password-link-secondary" %>
    </div>
  </div>
</div>