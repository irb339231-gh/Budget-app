<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "transactions_index", "data-turbo-track": "reload" %>
<% end %>

<div class="transactions-container">
  <section class="transactions-list-section">
    <div class="transactions-card">
      <div class="transactions-card-header">
        <span class="transactions-card-label">Transaction List</span>
        <h2>取引一覧</h2>
      </div>
      <div class="transactions-tabs">
        <input
          type="radio"
          name="transaction_tabs"
          id="transactions-tab-all"
          checked
        >
        <label for="transactions-tab-all">すべて</label>
        <input
          type="radio"
          name="transaction_tabs"
          id="transactions-tab-expense"
        >
        <label for="transactions-tab-expense">支出</label>
        <input
          type="radio"
          name="transaction_tabs"
          id="transactions-tab-income"
        >
        <label for="transactions-tab-income">収入</label>
        <div class="transactions-tab-content transactions-tab-all-content">
          <div class="transactions-table-wrapper">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>種別</th>
                  <th>名前</th>
                  <th>金額</th>
                  <th>登録日</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.each do |transaction| %>
                  <tr>
                    <td>
                      <% if transaction.expense? %>
                        <span class="transactions-badge transactions-badge-expense">
                          支出
                        </span>
                      <% else %>
                        <span class="transactions-badge transactions-badge-income">
                          収入
                        </span>
                      <% end %>
                    </td>
                    <td>
                      <%= transaction.name.presence || "未入力" %>
                    </td>
                    <td class="transactions-amount
                      <%= transaction.expense? ? "transactions-amount-expense" : "transactions-amount-income" %>">
                      <%= transaction.expense? ? "-" : "+" %>¥<%= number_with_delimiter(transaction.amount) %>
                    </td>
                    <td>
                      <%= transaction.created_at.strftime("%Y/%m/%d") %>
                    </td>
                    <td>
                      <%= button_to "削除",
                          transaction_path(transaction),
                          method: :delete,
                          class: "transactions-delete-button",
                          data: { turbo_confirm: "本当に削除しますか？" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="transactions-tab-content transactions-tab-expense-content">
          <div class="transactions-table-wrapper">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>名前</th>
                  <th>金額</th>
                  <th>登録日</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.select(&:expense?).each do |transaction| %>
                  <tr>
                    <td>
                      <%= transaction.name.presence || "未入力" %>
                    </td>
                    <td class="transactions-amount transactions-amount-expense">
                      -¥<%= number_with_delimiter(transaction.amount) %>
                    </td>
                    <td>
                      <%= transaction.created_at.strftime("%Y/%m/%d") %>
                    </td>
                    <td>
                      <%= button_to "削除",
                          transaction_path(transaction),
                          method: :delete,
                          class: "transactions-delete-button",
                          data: { turbo_confirm: "本当に削除しますか？" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="transactions-tab-content transactions-tab-income-content">
          <div class="transactions-table-wrapper">
            <table class="transactions-table">
              <thead>
                <tr>
                  <th>名前</th>
                  <th>金額</th>
                  <th>登録日</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @transactions.select(&:income?).each do |transaction| %>
                  <tr>
                    <td>
                      <%= transaction.name.presence || "未入力" %>
                    </td>
                    <td class="transactions-amount transactions-amount-income">
                      +¥<%= number_with_delimiter(transaction.amount) %>
                    </td>
                    <td>
                      <%= transaction.created_at.strftime("%Y/%m/%d") %>
                    </td>
                    <td>
                      <%= button_to "削除",
                          transaction_path(transaction),
                          method: :delete,
                          class: "transactions-delete-button",
                          data: { turbo_confirm: "本当に削除しますか？" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="transactions-home-action">
        <%= link_to "ホームへ",
            home_path,
            class: "transactions-button transactions-button-secondary" %>
      </div>
    </div>
  </section>
  <section class="transactions-navigation-section">
    <%= link_to "収入",
        incomes_path,
        class: "transactions-navigation-button" %>

    <%= link_to "将来の支出",
        future_expenses_path,
        class: "transactions-navigation-button" %>

    <%= link_to "固定費",
        fixed_costs_path,
        class: "transactions-navigation-button" %>
  </section>
</div>