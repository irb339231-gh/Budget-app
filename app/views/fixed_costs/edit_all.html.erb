<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "fixed_cost_edit_all", "data-turbo-track": "reload" %>
<% end %>

<div class="fixed-cost-edit-all-container">
  <section class="fixed-cost-edit-all-summary">
    <div class="fixed-cost-edit-all-summary-card">
      <div class="fixed-cost-edit-all-summary-header">
        <div>
          <span class="fixed-cost-edit-all-card-label">Fixed Cost Edit</span>
          <h1>固定費</h1>
        </div>
      </div>
      <div class="fixed-cost-edit-all-total">
        <span>固定費合計</span>
        <strong>¥<%= number_with_delimiter(@fixed_costs.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 固定費を追加", new_fixed_cost_path,class: "fixed-cost-edit-all-add-button" %>
    </div>
  </section>
 
  <section class="fixed-cost-edit-all-list-section">
    <div class="fixed-cost-edit-all-card">
      <div class="fixed-cost-edit-all-card-header">
        <div>
          <span class="fixed-cost-edit-all-card-label">Fixed Cost List</span>
          <h2>固定費編集</h2>
        </div>
      </div>

      <% if @fixed_costs.any? %>
        <div class="fixed-cost-edit-all-list">
          <% @fixed_costs.each do |fixed_cost| %>
            <div class="fixed-cost-edit-all-item">
              <div>
                <span class="fixed-cost-edit-all-item-name">
                  <%= fixed_cost.name %>
                </span>
              </div>
              <div class="fixed-cost-edit-all-item-right">
                <strong>¥<%= number_with_delimiter(fixed_cost.amount) %></strong>
                <%= link_to "編集",
                    edit_fixed_cost_path(fixed_cost),
                    class: "fixed-cost-edit-all-button fixed-cost-edit-all-button-edit" %>
                <%= button_to "削除",
                    fixed_cost_path(fixed_cost),
                    method: :delete,
                    class: "fixed-cost-edit-all-button fixed-cost-edit-all-button-delete",
                    data: { turbo_confirm: "削除してもよいですか？" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="fixed-cost-edit-all-empty">
          <p>固定費が登録されていません</p>
          <%= link_to "固定費を登録する", new_fixed_cost_path %>
        </div>
      <% end %>

      <div class="fixed-cost-edit-all-actions">
        <%= link_to "戻る",
            fixed_costs_path,
            class: "fixed-cost-edit-all-button fixed-cost-edit-all-button-back" %>
      </div>
    </div>
  </section>
</div>