<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "fixed_cost_new", "data-turbo-track": "reload" %>
<% end %>

<div class="fixed-cost-new-container">
  <section class="fixed-cost-new-section">
    <div class="fixed-cost-new-card">
      <div class="fixed-cost-new-header">
        <span class="fixed-cost-new-card-label">New Fixed Cost</span>
        <h1>固定費を追加</h1>
      </div>
      <%= form_with model: @fixed_cost,
          url: fixed_costs_path,
          scope: :fixed_cost do |f| %>
        <%= render "devise/shared/error_messages", resource: @fixed_cost %>
        <div class="fixed-cost-new-form-group">
          <%= f.label :name, "固定費名" %>
          <%= f.text_field :name,
              placeholder: "例：ローン、携帯代" %>
        </div>
        <div class="fixed-cost-new-form-group">
          <%= f.label :amount, "金額" %>
          <%= f.number_field :amount,
              placeholder: "例：100000" %>
        </div>
        <div class="fixed-cost-new-actions">
          <%= f.submit "追加する",
              class: "fixed-cost-new-button fixed-cost-new-button-primary" %>
          <%= link_to "戻る",
              fixed_costs_path,
              class: "fixed-cost-new-button fixed-cost-new-button-secondary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>