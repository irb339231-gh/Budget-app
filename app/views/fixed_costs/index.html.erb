<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "fixed_cost", "data-turbo-track": "reload" %>
<% end %>

<div class="fixed-cost-container">
  <%# 固定費合計 %>
  <section class="fixed-cost-summary">
    <div class="fixed-cost-summary-card">
      <div class="fixed-cost-summary-header">
        <div>
          <span class="fixed-cost-card-label">Fixed Cost</span>
          <h1>固定費</h1>
        </div>
      </div>
      <div class="fixed-cost-total">
        <span>固定費合計</span>
        <strong>¥<%= number_with_delimiter(@fixed_costs.sum(:amount)) %></strong>
      </div>
      <%= link_to "＋ 固定費を追加", new_fixed_cost_path, class: "fixed-cost-add-button" %>
    </div>
  </section>

  <%# 固定費一覧 %>
  <section class="fixed-cost-list-section">
    <div class="fixed-cost-card">
      <div class="fixed-cost-card-header">
        <div>
          <span class="fixed-cost-card-label">Fixed Cost List</span>
          <h2>固定費一覧</h2>
        </div>
      </div>

      <% if @fixed_costs.any? %>
        <div class="fixed-cost-list">
          <% @fixed_costs.each do |fixed_cost| %>
            <div class="fixed-cost-item">
              <div>
                <span class="fixed-cost-item-name"><%= fixed_cost.name %></span>
              </div>
              <div class="fixed-cost-item-right">
                <strong>-¥<%= number_with_delimiter(fixed_cost.amount) %></strong>
                <span>→</span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="fixed-cost-empty">
          <p>固定費が登録されていません</p><%= link_to "固定費を登録する", new_fixed_cost_path %>
        </div>
      <% end %>
      <div class="fixed-cost-actions">
        <%= link_to "編集する",
            edit_all_fixed_costs_path,
            class: "fixed-cost-button fixed-cost-button-primary" %>
        <%= link_to "ホームへ",
            home_path,
            class: "fixed-cost-button fixed-cost-button-secondary" %>
      </div>
    </div>
  </section>
</div>





