<div class="container mx-auto px-4 py-8 max-w-2xl">

  <%# ヘッダーカード %>
  <div class="rounded-3xl p-6 mb-6 text-white"
       style="background: linear-gradient(135deg, #f97316, #ea580c);">
    <p class="text-sm opacity-80 mb-1">固定費合計</p>
    <p class="text-4xl font-bold mb-4">
      ¥<%= number_with_delimiter(@fixed_costs.sum(:amount)) %>
    </p>
    <div class="flex justify-between items-center">
      <p class="text-sm opacity-80">登録件数：<%= @fixed_costs.count %>件</p>
      <%= link_to "＋ 追加する", new_fixed_cost_path, class: "btn btn-sm bg-white text-primary border-none" %>
    </div>
  </div> 

  <%# 一覧 %>
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h3 class="font-bold text-lg mb-4">固定費一覧</h3>

      <% if @fixed_costs.any? %>
        <div class="space-y-3">
          <% @fixed_costs.each do |fixed_cost| %>
            <div class="flex justify-between items-center p-4 bg-base-100 rounded-2xl">
              <div class="flex items-center gap-3">
                <span class="font-bold"><%= fixed_cost.name %></span>
              </div>
              <span class="font-bold text-error">¥<%= number_with_delimiter(fixed_cost.amount) %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-gray-500 py-8">
          <p>固定費が登録されていません</p>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4 mt-6">
        <%= link_to "編集する", edit_all_fixed_costs_path, class: "btn btn-primary rounded-2xl" %>
        <%= link_to "ホームへ", home_path, class: "btn btn-outline rounded-2xl" %>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4 mt-6">
    <a href="<%= incomes_path %>" class="btn btn-outline rounded-2xl">収入</a>
    <a href="<%= future_expenses_path %>" class="btn btn-outline rounded-2xl">将来の支出</a>
  </div>
</div>

